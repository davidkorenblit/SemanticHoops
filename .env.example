# =============================================================================
# Semantic Sport-Tech — Environment Variables Template
# Copy this file to .env and fill in your values. NEVER commit .env directly.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=sport_clips
QDRANT_API_KEY=               # Required only in Qdrant Cloud

# --- CLIP Model ---
CLIP_MODEL_NAME=ViT-B/32      # Options: ViT-B/32, ViT-L/14, ViT-L/14@336px
CLIP_DEVICE=cuda              # cuda | cpu

# --- Video Ingestion ---
YT_DLP_OUTPUT_DIR=data/raw/videos
FRAME_SAMPLE_DIR=data/processed/frames
SMART_SAMPLE_FPS_MIN=1        # Minimum FPS during low-motion segments
SMART_SAMPLE_FPS_MAX=10       # Maximum FPS during high-motion segments
MOTION_THRESHOLD=0.02         # Normalised optical-flow magnitude threshold

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
